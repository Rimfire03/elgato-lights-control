#include <winres.h>

101 RCDATA "@PLUGIN_DLL@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_COMMA@
 PRODUCTVERSION @APP_VERSION_COMMA@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "TomLine prod&co"
            VALUE "FileDescription", "Installateur du plugin OBS Elgato Lights Control"
            VALUE "FileVersion", "@APP_VERSION@"
            VALUE "ProductName", "Elgato Lights Control"
            VALUE "ProductVersion", "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
